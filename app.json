{
  "expo": {
    "name": "Moonlight_Mobile_Expo",
    "slug": "Moonlight_Mobile_Expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/styles/Moonlight_black.webp",
    "scheme": "moonlightmobileexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/styles/Moonlight_black.webp",
        "backgroundImage": "./src/styles/Moonlight_black.webp",
        "monochromeImage": "./src/styles/Moonlight_black.webp"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./src/styles/Moonlight_black.webp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/styles/Moonlight_black.webp",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
